{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/verify.sh\"",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/otel_tool_tracker.py\"",
            "timeout": 5,
            "statusMessage": "Shipping tool telemetry..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": []
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/otel_tool_tracker.py\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
